# NyayOS — Sprint 1 Foundation
# Variable NAMES ONLY. Never commit real values.
# Copy to .env.local and fill in locally; .env* is git-ignored.

# --- Client (exposed to the browser, non-secret values only) ---
VITE_APP_ENV=
VITE_APP_NAME=

# --- Server-only (read inside server functions; never import into client code) ---
# Sprint 1 is a frontend foundation build and requires none of these to run.
# Listed for Sprint 2 onward.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
