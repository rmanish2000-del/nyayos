{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "docs/ai/schemas/current_state.schema.json",
  "title": "NyayOS CURRENT_STATE",
  "description": "Where the project stands after the last completed assignment. 'derived' is regenerated by scripts/ai/state.mjs from the status registry; everything else is maintained by the tool that completes an assignment.",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "updated", "repository", "working_branch", "pull_request", "deployment", "last_assignment", "summary", "open_items", "derived"],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": "1.0" },
    "updated": { "$ref": "#/$defs/date" },
    "repository": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
    "working_branch": { "type": "string", "minLength": 1 },
    "pull_request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["number", "draft", "merged"],
      "properties": {
        "number": { "type": ["integer", "null"], "minimum": 1 },
        "draft": { "type": "boolean" },
        "merged": { "type": "boolean" }
      }
    },
    "deployment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed", "deployed", "environments", "note"],
      "properties": {
        "allowed": { "type": "boolean" },
        "deployed": { "type": "boolean" },
        "environments": { "type": "array", "items": { "type": "string" } },
        "note": { "type": "string" }
      }
    },
    "last_assignment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "status", "tool", "baseline", "commit", "pushed", "handoff"],
      "properties": {
        "id": { "$ref": "#/$defs/assignment_id" },
        "title": { "type": "string", "minLength": 1 },
        "status": { "enum": ["OPEN", "IN_PROGRESS", "REVIEW", "CANONICAL", "SUPERSEDED"] },
        "tool": { "$ref": "#/$defs/tool" },
        "baseline": { "$ref": "#/$defs/sha" },
        "commit": { "$ref": "#/$defs/sha" },
        "pushed": { "const": true },
        "handoff": { "type": "string", "pattern": "^docs/ai/tool-output/(claude-code|figma|lovable|gemini)/A-\\d{3}(-R\\d?)?\\.md$" }
      }
    },
    "summary": { "type": "string", "minLength": 20 },
    "open_items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "description"],
        "properties": {
          "id": { "type": "string", "pattern": "^OI-\\d{2}$" },
          "kind": { "enum": ["founder_decision", "finding", "residual", "dependency"] },
          "description": { "type": "string", "minLength": 10 },
          "decision": { "type": "string", "pattern": "^D-\\d{3}$" },
          "risk": { "type": "string", "pattern": "^RES-\\d{2}$" }
        }
      }
    },
    "derived": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "registry_updated", "task_count", "by_status", "highest_task_id", "open_tasks", "in_progress_tasks", "review_tasks"],
      "properties": {
        "source": { "const": "docs/founder/NYAYOS_STATUS_REGISTRY.json" },
        "registry_updated": { "type": ["string", "null"] },
        "task_count": { "type": "integer", "minimum": 0 },
        "by_status": {
          "type": "object",
          "additionalProperties": false,
          "required": ["OPEN", "IN_PROGRESS", "REVIEW", "CANONICAL", "SUPERSEDED"],
          "properties": {
            "OPEN": { "type": "integer", "minimum": 0 },
            "IN_PROGRESS": { "type": "integer", "minimum": 0 },
            "REVIEW": { "type": "integer", "minimum": 0 },
            "CANONICAL": { "type": "integer", "minimum": 0 },
            "SUPERSEDED": { "type": "integer", "minimum": 0 }
          }
        },
        "highest_task_id": { "$ref": "#/$defs/assignment_id" },
        "open_tasks": { "type": "array", "items": { "$ref": "#/$defs/assignment_id" } },
        "in_progress_tasks": { "type": "array", "items": { "$ref": "#/$defs/assignment_id" } },
        "review_tasks": { "type": "array", "items": { "$ref": "#/$defs/assignment_id" } }
      }
    }
  },
  "$defs": {
    "assignment_id": { "type": "string", "pattern": "^A-\\d{3}(-R\\d?)?$" },
    "sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "tool": { "enum": ["claude-code", "figma", "lovable", "gemini"] }
  }
}
